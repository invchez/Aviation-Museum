  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Welcome to AVIA Museum, a virtual exhibit hall you can walk through in
    first person. The collection brings together nine of the most recognizable aircraft
    in modern military aviation, among them the F-22 Raptor, the B-2 Spirit, the
    F-14 Tomcat and the A-10 Thunderbolt II. Walk up to any aircraft to open its
    exhibit plaque and read the manufacturer, first flight, wingspan, top speed and
    a short history. If the plaque does not answer your question, ask the AI museum
    guide: type a question about the aircraft in front of you and it replies in text
    and reads the answer aloud. Two exhibit layouts rotate the collection on display,
    and a day-night cycle moves the light across the hall as you explore.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5895bd8cdc73b4b54bdd65d6e2d7e216, type: 2}
  m_sharedMaterial: {fileID: -7650781133102241324, guid: 5895bd8cdc73b4b54bdd65d6e2d7e216, type: 2}
