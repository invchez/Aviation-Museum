default_platform(:ios)

platform :ios do
  desc "Push metadata, screenshots, pricing, and App Review info to App Store Connect (no binary)"
  lane :upload_metadata do
    # sync_screenshots is still flagged beta; without this deliver aborts.
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"

    api_key = app_store_connect_api_key(
      key_id: "ZW7RMV5D95",
      issuer_id: "69a6de89-9f6e-47e3-e053-5b8c7c11a4d1",
      key_filepath: File.expand_path("AuthKey_ZW7RMV5D95.p8", __dir__)
    )

    deliver(
      api_key: api_key,
      app_identifier: "com.alexli.aviamuseum",

      # The binary is archived and uploaded manually via Xcode / Transporter.
      skip_binary_upload: true,

      skip_metadata: false,
      skip_screenshots: false,
      # Checksum-based sync: skips unchanged screenshots and avoids the flaky
      # delete-all-then-verify path that overwrite_screenshots uses.
      sync_screenshots: true,

      metadata_path: File.expand_path("metadata", __dir__),
      # Top-level screenshots/ folder; deliver requires a locale subfolder
      # (screenshots/en-US/) and infers iPhone vs iPad from image resolution.
      screenshots_path: File.expand_path("../screenshots", __dir__),

      # NOTE: pricing and territory availability can no longer be set via the
      # API (Apple removed the endpoints deliver's price_tier used). Set the
      # price to Free once in App Store Connect → Pricing and Availability;
      # new apps default to all countries. See fastlane/RELEASE_GUIDE.md.

      # API-key auth cannot scan IAPs (and this app has none).
      precheck_include_in_app_purchases: false,

      submission_information: {
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false
      },

      # Non-interactive: skip the HTML preview confirmation.
      force: true
    )
  end
end
